# Local run without Docker. Copy to backend/.env
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string-of-48-plus-characters
CORS_ORIGINS=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dragonwok
DB_USER=dragonwok
DB_PASSWORD=replace-with-a-db-password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
