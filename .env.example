# Copy to .env and change the values. NEVER commit .env.

# ---- General ----
# development | production
ENVIRONMENT=development
# Make a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-of-48-plus-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
# comma separated, no spaces needed
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# ---- Database (local Docker MySQL; for Amazon RDS see README) ----
# used only by the local MySQL container
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
# docker compose overrides this to "db"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dragonwok
DB_USER=dragonwok
DB_PASSWORD=replace-with-a-db-password
# For Amazon RDS set these (TLS with certificate checks):
DB_SSL_ENABLED=false
DB_SSL_CA=/certs/rds-global-bundle.pem
DB_SSL_VERIFY_IDENTITY=true
# Or give one full URL instead of the DB_* values:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dragonwok?charset=utf8mb4

# ---- Business rules (INR) ----
DELIVERY_FEE=40.00
# 5%
TAX_RATE=0.05
# 0 = delivery fee is always charged
FREE_DELIVERY_ABOVE=0

# ---- First admin account (created by the seed script) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# set to false in production after the first start
RUN_SEED=true

# ---- Frontend (public values only, baked in at build time) ----
VITE_API_URL=http://localhost:8000/api/v1
